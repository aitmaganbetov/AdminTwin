{
  "name": "admintwin-web",
  "version": "0.1.0",
  "private": true,
  "description": "AdminTwin Web UI (MVP)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.cjs",
    "ui:audit": "node scripts/ui-audit.cjs",
    "ui:scenarios": "node scripts/ui-scenarios.cjs"
  },
  "dependencies": {
    "@carbon/icons-react": "11.92.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
