# admintwin-orchestrator: Python AI-слой (ТЗ §3.5, contracts §4), порт 8090.
# Сборка из корня репозитория:
#   docker build -f infra/docker/Dockerfile.orchestrator -t admintwin-orchestrator:dev .
# Обязательно: ADMINTWIN_SERVICE_TOKEN (без него сервис не стартует), ADMINTWIN_CORE_URL,
# ADMINTWIN_AI_CONFIG (конфигурация провайдеров/Model Profiles; ключи — через env/Vault).
FROM python:3.13-slim AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /src/ai
COPY ai/pyproject.toml ai/README.md ./
COPY ai/src ./src
COPY ai/tools ./tools
COPY ai/contracts ./contracts
COPY ai/agents ./agents
COPY ai/evals ./evals
COPY ai/config ./config
# Неинтерактивная сборка wheel: контракты копируются внутрь пакета (admintwin_ai/_data)
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip \
 && /opt/venv/bin/pip install .

FROM python:3.13-slim
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin admintwin
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ADMINTWIN_ORCHESTRATOR_HOST=0.0.0.0 ADMINTWIN_ORCHESTRATOR_PORT=8090 \
    ADMINTWIN_CORE_URL=http://core:8080
EXPOSE 8090
USER 10001:10001
HEALTHCHECK NONE
ENTRYPOINT ["admintwin-orchestrator"]
