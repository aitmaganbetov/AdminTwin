{
  "$schema": "https://schemas.admintwin.io/ai/tools/tool-contract.schema.json",
  "name": "metrics.query",
  "kind": "read",
  "version": "1.0.0",
  "description": "Временной ряд метрики актива за окно (VictoriaMetrics, tenant-label).",
  "data_class": "internal",
  "max_response_bytes": 32768,
  "rate_limit_per_minute": 60,
  "capabilities": [
    "SYS-011"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id",
      "metric",
      "window"
    ],
    "properties": {
      "asset_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "metric": {
        "type": "string",
        "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]{0,199}$"
      },
      "window": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,3}[smhd]$",
        "description": "Окно назад от текущего момента: 15m, 1h, 7d"
      },
      "step": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,3}[smh]$"
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id",
      "metric",
      "series"
    ],
    "properties": {
      "asset_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "metric": {
        "type": "string"
      },
      "window": {
        "type": "string"
      },
      "series": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "labels",
            "points"
          ],
          "properties": {
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "points": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    }
  }
}
