{
  "$schema": "https://schemas.admintwin.io/ai/tools/tool-contract.schema.json",
  "name": "postgres.activity",
  "kind": "read",
  "version": "1.0.0",
  "description": "Активные сессии и ожидания PostgreSQL (pg_stat_activity, read-only роль).",
  "data_class": "confidential",
  "max_response_bytes": 32768,
  "rate_limit_per_minute": 60,
  "capabilities": [
    "DBA-001"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id"
    ],
    "properties": {
      "asset_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "database": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_$]{0,62}$"
      },
      "min_duration_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 86400
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "max_connections",
      "total_connections",
      "sessions"
    ],
    "properties": {
      "max_connections": {
        "type": "integer",
        "minimum": 0
      },
      "total_connections": {
        "type": "integer",
        "minimum": 0
      },
      "sessions": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "state"
          ],
          "properties": {
            "pid": {
              "type": "integer"
            },
            "usename": {
              "type": [
                "string",
                "null"
              ]
            },
            "datname": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "type": [
                "string",
                "null"
              ]
            },
            "wait_event_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "wait_event": {
              "type": [
                "string",
                "null"
              ]
            },
            "query_start": {
              "type": [
                "string",
                "null"
              ]
            },
            "duration_s": {
              "type": [
                "number",
                "null"
              ]
            },
            "query": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2048
            }
          }
        }
      }
    }
  }
}
