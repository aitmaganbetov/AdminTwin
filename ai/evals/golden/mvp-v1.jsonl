{"case_id": "http502-upstream-container-stopped-001", "scenario": "http_502", "title": "HTTP 502 на nginx: upstream-контейнер api остановлен (exit 137, OOM)", "input": {"alert": {"type": "http_502", "asset_type": "load_balancer", "service_kind": "reverse_proxy", "summary": "5xx rate 38% on shop-frontend for 5m"}, "signals": [{"tool": "logs.search", "line": "connect() failed (111: Connection refused) while connecting to upstream, upstream: \"http://10.20.0.15:8080/\""}, {"tool": "docker.container.inspect", "container": "shop-api", "state": {"status": "exited", "exit_code": 137, "oom_killed": true}}, {"tool": "postgres.activity", "total_connections": 42, "max_connections": 200}]}, "expected": {"root_cause": "upstream_container_stopped", "acceptable_causes": ["upstream_container_oom"], "evidence": ["nginx upstream connection refused", "container shop-api exited 137 oom_killed"], "expected_checks": ["logs.search", "docker.container.inspect"], "excluded_causes": ["db_connections_exhausted", "firewall_policy_block"]}, "tags": ["mvp", "golden-v1"]}
{"case_id": "disk-exhaustion-var-log-001", "scenario": "disk_exhaustion", "title": "Заполнение /var на web-хосте журналами приложения", "input": {"alert": {"type": "disk_usage_high", "asset_type": "linux_host", "summary": "/var usage 97%"}, "signals": [{"tool": "linux.disk.usage", "mount": "/var", "use_percent": 97.4, "top_dirs": [{"path": "/var/log/app", "size_bytes": 41231686041}]}, {"tool": "logs.search", "line": "logrotate: error: skipping \"/var/log/app/app.log\" because parent directory has insecure permissions"}]}, "expected": {"root_cause": "log_rotation_failure", "acceptable_causes": ["application_log_growth"], "evidence": ["/var 97% used", "/var/log/app 41G", "logrotate skipping app.log"], "expected_checks": ["linux.disk.usage", "logs.search"], "excluded_causes": ["database_bloat"]}, "tags": ["mvp", "golden-v1"]}
{"case_id": "container-stop-healthcheck-001", "scenario": "container_stop", "title": "Остановка контейнера worker после неудачных healthcheck и исчерпания restart policy", "input": {"alert": {"type": "container_stopped", "asset_type": "docker_host", "service_kind": "container", "summary": "container billing-worker not running"}, "signals": [{"tool": "docker.container.inspect", "container": "billing-worker", "state": {"status": "exited", "exit_code": 1, "restart_count": 5, "health": "unhealthy"}}, {"tool": "logs.search", "line": "FATAL: could not read config /etc/billing/config.yaml: permission denied"}]}, "expected": {"root_cause": "container_config_error", "acceptable_causes": [], "evidence": ["exit code 1 after 5 restarts", "config permission denied"], "expected_checks": ["docker.container.inspect", "logs.search"], "excluded_causes": ["host_out_of_memory"]}, "tags": ["mvp", "golden-v1"]}
