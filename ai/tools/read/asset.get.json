{
  "$schema": "https://schemas.admintwin.io/ai/tools/tool-contract.schema.json",
  "name": "asset.get",
  "kind": "read",
  "version": "1.0.0",
  "description": "Карточка актива из CMDB (environment, criticality, ring, data_class, legal_hold).",
  "data_class": "internal",
  "max_response_bytes": 32768,
  "rate_limit_per_minute": 60,
  "capabilities": [
    "ITSM-005"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id"
    ],
    "properties": {
      "asset_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id",
      "name",
      "type",
      "environment",
      "criticality"
    ],
    "properties": {
      "asset_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "name": {
        "type": "string",
        "maxLength": 255
      },
      "type": {
        "type": "string",
        "maxLength": 64
      },
      "environment": {
        "type": "string",
        "enum": [
          "production",
          "staging",
          "dev",
          "test"
        ]
      },
      "criticality": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ]
      },
      "ring": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 32
      },
      "service_tier": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 3
      },
      "data_class": {
        "type": "string",
        "enum": [
          "public",
          "internal",
          "confidential",
          "pii",
          "secret",
          "unknown"
        ]
      },
      "legal_hold": {
        "type": "boolean"
      },
      "tags": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "maxLength": 255
        }
      }
    }
  }
}
