# admintwin-core: один статический бинарник ядра (§3.5).
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
COPY services ./services
COPY connectors ./connectors
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/admintwin-core ./cmd/admintwin-core

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /opt/admintwin
COPY --from=build /out/admintwin-core /usr/local/bin/admintwin-core
COPY runbooks ./runbooks
COPY capabilities ./capabilities
COPY standards ./standards
COPY db/migrations ./db/migrations
COPY ai/tools ./ai/tools
COPY infra/dev/fixtures.yaml ./infra/dev/fixtures.yaml
ENV ADMINTWIN_ROOT=/opt/admintwin ADMINTWIN_ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/admintwin-core"]
