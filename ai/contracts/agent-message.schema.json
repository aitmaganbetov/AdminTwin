{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.admintwin.io/ai/contracts/agent-message/1.3.json",
  "title": "AdminTwin inter-agent message",
  "description": "Контракт межагентного взаимодействия (ТЗ §7). Транспорт NATS JetStream, JSON; at-least-once, идемпотентность по message_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "tenant_id", "task_id", "parent_task_id",
    "correlation_id", "causation_id", "from_agent", "to_agent", "type", "priority",
    "timestamp", "scope", "budget", "payload"
  ],
  "properties": {
    "schema_version": {"const": "1.3"},
    "message_id": {"$ref": "#/$defs/uuid"},
    "tenant_id": {"$ref": "#/$defs/uuid"},
    "task_id": {"$ref": "#/$defs/uuid"},
    "parent_task_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "causation_id": {"$ref": "#/$defs/uuid"},
    "from_agent": {"$ref": "#/$defs/agent_id"},
    "to_agent": {"$ref": "#/$defs/agent_id"},
    "type": {
      "type": "string",
      "enum": [
        "task.request", "task.accepted", "task.progress", "task.result", "task.failed",
        "task.blocked", "task.input_required", "task.cancelled",
        "evidence.added", "change.proposed", "approval.requested",
        "execution.started", "execution.completed", "execution.cancellation_pending",
        "budget.warning", "budget.exhausted"
      ]
    },
    "priority": {"type": "string", "enum": ["low", "normal", "high", "critical"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_ids", "environment", "data_sensitivity_max"],
      "properties": {
        "asset_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "maxItems": 500, "uniqueItems": true},
        "environment": {"type": "string", "enum": ["production", "staging", "dev", "test"]},
        "data_sensitivity_max": {"type": "string", "enum": ["public", "internal", "confidential", "pii", "secret"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_tool_calls", "deadline_at"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "deadline_at": {"type": "string", "format": "date-time"}
      }
    },
    "payload": {
      "type": "object",
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
        "constraints": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 50},
        "context_summary_ref": {"type": "string", "pattern": "^evidence://"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "task.request"}}},
      "then": {"properties": {"payload": {"required": ["objective", "constraints"]}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
  }
}
