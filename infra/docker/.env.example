# Скопируйте в infra/docker/.env и заполните. Файл .env не коммитится (.gitignore).
# Генерация:  openssl rand -base64 32  (ключи),  openssl rand -base64 48  (токен), openssl rand -hex 24 (пароль)

ADMINTWIN_PG_PASSWORD=
ADMINTWIN_SERVICE_TOKEN=
ADMINTWIN_AUDIT_SIGNING_KEY=
ADMINTWIN_PII_MASTER_KEY=

# Режим разработки (по умолчанию). Для production: false + OIDC + Vault.
ADMINTWIN_SIMULATOR=true
ADMINTWIN_DEV_AUTH=true
ADMINTWIN_AI_OFFLINE_FAKE=true

# OIDC (production)
ADMINTWIN_OIDC_ISSUER=
ADMINTWIN_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_ISSUER=

# Vault / OpenBao (профиль vault — dev-сервер на http://openbao:8200)
VAULT_ADDR=
VAULT_TOKEN=

# Телеметрия (профиль observability)
# ADMINTWIN_VICTORIAMETRICS_URL=http://victoriametrics:8428
# ADMINTWIN_LOKI_URL=http://loki:3100

# LLM-провайдеры (BYO). Без них работает только офлайн-модель.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
